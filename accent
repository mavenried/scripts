#! /bin/bash
case $1 in
"teal")
  gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Teal-Dark'
  ln /home/maverikio/.themes/Catppuccin-Teal-Dark/gtk-4.0/assets /home/maverikio/.config/gtk-4.0/assets -sf
  ln /home/maverikio/.themes/Catppuccin-Teal-Dark/gtk-4.0/gtk.css /home/maverikio/.config/gtk-4.0/gtk.css -sf
  ln /home/maverikio/.themes/Catppuccin-Teal-Dark/gtk-4.0/gtk-dark.css /home/maverikio/.config/gtk-3.0/gtk-dark.css -sf
  sudo flatpak override --env=GTK_THEME="Catppuccin-Teal-Dark"
  echo "\$hl = rgba(94e2d5ff)" >~/.config/hypr/accent.conf
  echo "@import url('colors.css');@define-color hl @teal;" >~/.config/waybar/accent.css
  ;;
"purple")
  gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Purple-Dark'
  ln /home/maverikio/.themes/Catppuccin-Purple-Dark/gtk-4.0/assets /home/maverikio/.config/gtk-4.0/assets -sf
