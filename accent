  teal)
    set_theme Catppuccin-Teal-Dark teal Adwaita-Teal 94e2d5 teal
    ;;
  purple)
    set_theme Catppuccin-Purple-Dark purple Cpcn-Purple cba6f7 mauve
    ;;
  red)
    set_theme Catppuccin-Red-Dark red Adwaita-Red f38ba8 red
    ;;
  green)
