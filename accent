  ;;
"green")
  gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Green-Dark'
  ln /home/maverikio/.themes/Catppuccin-Green-Dark/gtk-4.0/assets /home/maverikio/.config/gtk-4.0/assets -sf
  ln /home/maverikio/.themes/Catppuccin-Green-Dark/k/gtk-4.0/gtk.css /home/maverikio/.config/gtk-4.0/gtk.css -sf
  ln /home/maverikio/.themes/Catppuccin-Green-Dark/gtk-4.0/gtk-dark.css /home/maverikio/.config/gtk-3.0/gtk-dark.css -sf
  sudo flatpak override --env=GTK_THEME=Catppuccin-Green-Dark
  echo "\$hl = rgba(a6e3a1ff)" >~/.config/hypr/accent.conf
  echo "@import url('colors.css');@define-color hl @green;" >~/.config/waybar/accent.css
  ;;
"orange")
  gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Orange-Dark'
  ln /home/maverikio/.themes/Catppuccin-Orange-Dark/gtk-4.0/assets /home/maverikio/.config/gtk-4.0/assets -sf
  ln /home/maverikio/.themes/Catppuccin-Orange-Dark/gtk-4.0/gtk.css /home/maverikio/.config/gtk-4.0/gtk.css -sf
  ln /home/maverikio/.themes/Catppuccin-Orange-Dark/gtk-4.0/gtk-dark.css /home/maverikio/.config/gtk-3.0/gtk-dark.css -sf
  sudo flatpak override --env=GTK_THEME=Catppuccin-Orange-Dark
  echo "\$hl = rgba(fab387ff)" >~/.config/hypr/accent.conf
