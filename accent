#!/bin/bash

set_theme() {
  local gtk_theme="$1" gsettings_accent="$2" icon_theme="$3" accent_hex="$4" waybar_color="$5"

  colorctl vars +accent-color="$accent_hex"
  colorctl vars +waybar-color="$waybar_color"
  colorctl vars +icon-theme="$icon_theme"
  colorctl vars +gtk-theme="$gtk_theme"

  echo "Setting Themes..."
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
  gsettings set org.gnome.desktop.interface accent-color "$gsettings_accent"
  gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"

  echo "Linking Files..."
  ln ~/.themes/"$gtk_theme"/gtk-4.0/asset_themes ~/.config/gtk-4.0/assets -sf
  ln ~/.themes/"$gtk_theme"/gtk-4.0/gtk.css ~/.config/gtk-4.0/gtk.css -sf
  ln ~/.themes/"$gtk_theme"/gtk-4.0/gtk-dark.css ~/.config/gtk-4.0/gtk-dark.css -sf

  echo "Applying Colorctl..."
  sleep 0.1
  colorctl apply >/dev/null

  echo "Overriding flatpak themes (need sudo)"
  sudo flatpak override --env=GTK_THEME="$gtk_theme"
  exit 0
}

apply_vars() {
  local kv
  for kv in "$@"; do
    colorctl vars "+$kv"
  done
}

apply_variant() {
  local -n variants="$1"
  local key="$2" entry
  entry="${variants[$key]:-}"
  if [ -z "$entry" ]; then
    echo "Not a valid variant: {$(printf '%s\n' "${!variants[@]}" | sort | paste -sd'|')}"
    return 1
  fi
  IFS='|' read -r gtk_theme gsettings_accent icon_theme accent_hex waybar_color <<<"$entry"
  set_theme "$gtk_theme" "$gsettings_accent" "$icon_theme" "$accent_hex" "$waybar_color"
}

