  ln /home/maverikio/.themes/Catppuccin-Purple-Dark/gtk-4.0/gtk-dark.css /home/maverikio/.config/gtk-3.0/gtk-dark.css -sf
  sudo flatpak override --env=GTK_THEME=Catppuccin-Purple-Dark
  echo "\$hl = rgba(cba6f7ff)" >~/.config/hypr/accent.conf
  echo "@import url('colors.css');@define-color hl @mauve;" >~/.config/waybar/accent.css
  ;;
"red")
  gsettings set org.gnome.desktop.interface gtk-theme 'Catppuccin-Red-Dark'
  ln /home/maverikio/.themes/Catppuccin-Red-Dark/gtk-4.0/assets /home/maverikio/.config/gtk-4.0/assets -sf
