#! /bin/sh

set_theme() {
  echo "Setting Themes..."
  gsettings set org.gnome.desktop.interface gtk-theme "$1"
  gsettings set org.gnome.desktop.interface accent-color "$2"
  gsettings set org.gnome.desktop.interface icon-theme "$3"

  echo "Linking Files..."
  ln ~/.themes/"$1"/gtk-4.0/asset_themes ~/.config/gtk-4.0/assets -sf
  ln ~/.themes/"$1"/gtk-4.0/gtk.css ~/.config/gtk-4.0/gtk.css -sf
  ln ~/.themes/"$1"/gtk-4.0/gtk-dark.css ~/.config/gtk-4.0/gtk-dark.css -sf

  echo "Updating colorctl..."
  colorctl vars +accent-color="$4"
  colorctl vars +waybar-color="$5"
  colorctl vars +icon-theme="$3"
  colorctl vars +gtk-theme="$1"

  echo "Applying colorctl..."
  colorctl apply
  cat ~/.config/niri/pieces/* >~/.config/niri/config.kdl
  sudo flatpak override --env=GTK_THEME=$1
}

case $1 in
cpcn)
  colorctl vars +bg-color=181824
  colorctl vars +starship-palette=catppuccin
  colorctl vars +hyprlock-hour-color=94e2d5
  colorctl vars +hyprlock-minutes-color=cba6f7
  colorctl vars +hyprlock-battery-color=94e2d5
  colorctl vars +hyprlock-uptime-color=b8bb26
  colorctl vars +text-color=cdd6f4
  colorctl vars +dark-bg-color=11111b
  colorctl vars +bg-color=181825
  colorctl vars +ghostty_theme=CatppuccinMocha

  ln /mnt/DATA/Pictures/Wallpapers/cpcn.jpg /mnt/DATA/Pictures/CURRENT -sf
