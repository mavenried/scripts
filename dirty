#!/bin/bash

cd "$PROJECT_HOME" || exit 1

check_unpushed=0
check_detached=0

for arg in "$@"; do
    case "$arg" in
        --unpushed) check_unpushed=1 ;;
        --detached) check_detached=1 ;;
        --all) check_unpushed=1; check_detached=1 ;;
    esac
done

cols=$(tput cols 2>/dev/null || echo 80)

c_reset='\033[0m'
c_name='\033[1;33m'
c_name_noremote='\033[1;31m'

c_unpushed='\033[0;36m'
c_unpulled='\033[0;34m'
c_detached='\033[1;35m'
c_path='\033[2m'

# per-code colors for the dirty breakdown, mirroring git's own status letters
declare -A code_color=(
    [M]='\033[0;33m'   # modified
    [A]='\033[0;32m'   # added
    [D]='\033[0;31m'   # deleted
    [R]='\033[0;35m'   # renamed
    [C]='\033[0;36m'   # copied
    [U]='\033[1;31m'   # unmerged / conflict
    ['?']='\033[0;34m' # untracked
)
code_order=(M A D R C U '?')

join_by() {
    local d=$1 f=$2
    shift 2
    printf '%s' "$f" "${@/#/$d}"
}

while IFS= read -r -d '' gitdir; do
    repo_dir=$(dirname "$gitdir")

    if [[ "$repo_dir" == "." ]]; then
        name="$(basename "$PWD")"
    else
        name=$(basename "$repo_dir")
    fi
    path=$(realpath "$repo_dir")

    tags=()
    detail_plain=()
    detail_colored=()
    no_remote=0

    declare -A code_count=()
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        code="${line:0:2}"
        case "$code" in
            "??") cat='?' ;;
            "AA"|"DD"|*U*) cat='U' ;;
            *A*) cat='A' ;;
            *D*) cat='D' ;;
            *R*) cat='R' ;;
            *C*) cat='C' ;;
            *) cat='M' ;;
        esac
        code_count[$cat]=$(( ${code_count[$cat]:-0} + 1 ))
    done <<< "$(git -C "$repo_dir" status --porcelain 2>/dev/null)"

    dirty_plain=()
    dirty_colored=()
    for cat in "${code_order[@]}"; do
        n=${code_count[$cat]:-0}
        (( n == 0 )) && continue
        chunk="${cat}${n}"
        dirty_plain+=("$chunk")
        dirty_colored+=("$(printf '%b%s%b' "${code_color[$cat]}" "$chunk" "$c_reset")")
    done

    if (( ${#dirty_plain[@]} > 0 )); then
        tags+=("dirty")
        detail_plain+=("$(join_by ' ' "${dirty_plain[@]}")")
        detail_colored+=("$(join_by ' ' "${dirty_colored[@]}")")
    fi

    if [[ -z "$(git -C "$repo_dir" remote 2>/dev/null)" ]]; then
        tags+=("no-remote")
        no_remote=1
    else
        if (( check_unpushed )); then
            upstream=$(git -C "$repo_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
            if [[ -n "$upstream" ]]; then
                ahead=$(git -C "$repo_dir" rev-list --count '@{u}..HEAD' 2>/dev/null)
                behind=$(git -C "$repo_dir" rev-list --count 'HEAD..@{u}' 2>/dev/null)

                if (( ahead > 0 )); then
                    tags+=("unpushed")
                    detail_plain+=("${ahead} ahead")
                    detail_colored+=("$(printf '%b%s%b' "$c_unpushed" "${ahead} ahead" "$c_reset")")
                fi
                if (( behind > 0 )); then
                    tags+=("unpulled")
                    detail_plain+=("${behind} behind")
                    detail_colored+=("$(printf '%b%s%b' "$c_unpulled" "${behind} behind" "$c_reset")")
                fi
            fi
        fi
    fi

    if (( check_detached )) && [[ -z "$(git -C "$repo_dir" symbolic-ref -q HEAD)" ]]; then
        tags+=("detached")
        detail_plain+=("detached HEAD")
        detail_colored+=("$(printf '%b%s%b' "$c_detached" "detached HEAD" "$c_reset")")
    fi

    (( ${#tags[@]} == 0 )) && continue

    plain_detail=$(join_by ", " "${detail_plain[@]}")
    colored_detail=$(join_by ", " "${detail_colored[@]}")

    name_color="$c_name"
    (( no_remote )) && name_color="$c_name_noremote"

    plain_left=" ${name}  ${path}"
    colored_left="$(printf ' %b%s%b  %b%s%b' "$name_color" "$name" "$c_reset" "$c_path" "$path" "$c_reset")"

    pad=$(( cols - ${#plain_left} - ${#plain_detail} - 2 ))
    (( pad < 1 )) && pad=1

    printf "%b%*s%b%b\n" \
        "$colored_left" \
        "$pad" "" \
        "$colored_detail" \
        "$c_reset"
done < <(find . -type d -name ".git" -print0 2>/dev/null)
