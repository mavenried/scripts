#!/bin/bash

fmt() {
  printf "%s%3d%s" "$1" "$2" "$3"
}

# CPU usage: sample /proc/stat, sleep (also throttles repeated invocations), sample again, diff
read -r _ u1 n1 s1 i1 _ < /proc/stat
sleep 1
read -r _ u2 n2 s2 i2 _ < /proc/stat

cpu=$(awk -v b1="$((u1 + s1))" -v t1="$((u1 + s1 + i1))" \
         -v b2="$((u2 + s2))" -v t2="$((u2 + s2 + i2))" \
     'BEGIN { db = b2 - b1; dt = t2 - t1; if (dt > 0) printf "%.0f", db / dt * 100; else print 0 }')

# RAM usage
ram=$(free | awk '/Mem:/ {printf "%.0f", $3/$2*100}')

# Disk usage
disk=$(df /mnt/DATA | awk 'NR==2 {printf "%.0f", $5}' | tr -d '%')

# Battery info
bat_path="/sys/class/power_supply/BAT1"
if [ -d "$bat_path" ]; then
  bat=$(awk '{printf "%.0f", $1*100/$(NF)}' <(paste "$bat_path/energy_now" "$bat_path/energy_full"))
  charging=$(cat "$bat_path/status")
  power_now=$(cat "$bat_path/power_now" 2>/dev/null)
else
  bat=""
  charging=""
  power_now=""
fi

# Build parts array
parts=(
  "$(fmt " " "$cpu" "%")"
  "$(fmt " " "$ram" "%")"
  "$(fmt "󰋊 " "$disk" "%")"
)

# Battery icon
if [ -n "$bat" ]; then
  if [ "$charging" != "Discharging" ]; then
    icon="󰂄 "
  else
    icons=("󰁻 " "󰁻 " "󰁼 " "󰁽 " "󰁾 " "󰁿 " "󰂀 " "󰂀 " "󰂂 " "󰁹 ")
    index=$(((bat - 1) / 10))
    icon="${icons[index]}"
  fi
  parts+=("$(fmt "$icon" "$bat" "%")")
fi

# Add power_now if available
if [ -n "$power_now" ]; then
  power_now=$((power_now / 1000000))
  parts+=("$(fmt "󱐋" "$power_now" "W")")
fi

# Print joined parts
for ((i = 0; i < ${#parts[@]}; i++)); do
  printf "%s" "${parts[i]}"
  if ((i < ${#parts[@]} - 1)); then
    printf " | "
  fi
done
printf "\n"
