#!/bin/env python3
"""Rename utilities. Usage: rn <subcommand> [args...]"""

import os
import re
import sys


def strip_spaces(args):
    try:
        for file in args:
            if not os.path.exists(file):
                continue

            new_name = strip_spaces_name(file)

            if file == new_name:
                continue

            user_input = (
                input(f"Rename '{file}' to '{new_name}'? (Y/n): ").strip().lower()
            )

            if user_input in ("", "y", "yes"):
                try:
                    os.rename(file, new_name)
                    print(f"Renamed: {file} -> {new_name}")
                except Exception as e:
                    print(f"Error renaming {file}: {e}")
    except KeyboardInterrupt:
        print("\nExiting...")
        sys.exit(0)


def strip_spaces_name(file):
    file_name, ext = os.path.splitext(file)

    if " " not in file_name and ext == ext.lower():
        return file

    clean_name = "".join(
        [word[0].upper() + word[1:] for word in file_name.split(" ") if word]
    )
    return f"{clean_name}{ext.lower()}"


def clean_name(args):
    try:
        for file in args:
            if not os.path.exists(file):
                continue

            file_name, ext = os.path.splitext(file)
            file_name = re.sub(
                r"^(?:OceanofPdf\.com|_oceanofpdf.com)",
                "",
                file_name,
                count=1,
                flags=re.IGNORECASE,
            )
            file_name = re.sub(r"_\-_.*$", "", file_name)
            file_name = file_name.replace("_", " ")
            new_name = strip_spaces_name(f"{file_name}{ext}")

            if file == new_name:
                continue

            user_input = (
                input(f"Rename '{file}' to '{new_name}'? (Y/n): ").strip().lower()
            )

            if user_input in ("", "y", "yes"):
                try:
                    os.rename(file, new_name)
                    print(f"Renamed: {file} -> {new_name}")
                except Exception as e:
                    print(f"Error renaming {file}: {e}")
    except KeyboardInterrupt:
        print("\nExiting...")
        sys.exit(0)


SUBCOMMANDS = {
    "strip-spaces": strip_spaces,
    "clean-name": clean_name,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in SUBCOMMANDS:
        print(f"Usage: rn <{'|'.join(SUBCOMMANDS)}> [args...]")
        sys.exit(1)

    SUBCOMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
