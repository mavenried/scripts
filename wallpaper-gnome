
#! /bin/sh
if [[ -e "/home/maverikio/.cache/wallpaper-set-random.lock" ]]; then
  hyprctl notify 6 1000 0 "Found lockfile"
  exit
else
  touch "/home/maverikio/.cache/wallpaper-set-random.lock"
  CURRENT=/home/maverikio/Pictures/CURRENT
  WALLPAPER_QUEUE=/home/maverikio/Pictures/WallpaperQueue/
  NEW="$WALLPAPER_QUEUE$(ls $WALLPAPER_QUEUE | sort -R | tail -1)"
  cp $NEW $CURRENT
  rm "/home/maverikio/.cache/wallpaper-set-random.lock"
fi
